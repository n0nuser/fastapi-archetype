# CORE SETTINGS
SECRET_KEY=mysecretkey123
ENVIRONMENT=DEV
BACKEND_CORS_ORIGINS=["http://localhost:3000", "https://myfrontendapp.com"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
APP_LOG_FILE_PATH=logs/app.log # Set the same path in the docker-compose.yml file
LOG_FORMAT=text # "json" makes both handlers emit structured logs ready for ELK

# OPENTELEMETRY
OTEL_ENABLED=false # Enables tracing instrumentation and OTLP export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# REDIS CACHE
CACHE_ENABLED=false # Caches GET customer responses in Redis when enabled
CACHE_EXPIRE_SECONDS=60
REDIS_URL=redis://redis:6379/0

# POSTGRESQL DATABASE
POSTGRES_SERVER=localhost
POSTGRES_USER=myappuser
POSTGRES_PASSWORD=mypassword123
POSTGRES_PORT=5432
POSTGRES_DB=mydatabase

# PGADMIN
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin

# PROJECT SETTINGS
BASE_API_PATH={{ cookiecutter.base_api_path }}
API_VERSION={{ cookiecutter.api_version }}
PROJECT_NAME="{{ cookiecutter.project_name }}"
PROJECT_DESCRIPTION="{{ cookiecutter.project_description }}"
PROJECT_VERSION={{ cookiecutter.api_version }}
CONTACT_NAME="{{ cookiecutter.author_name }}"
CONTACT_EMAIL="{{ cookiecutter.author_email }}"
